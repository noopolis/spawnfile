spawnfile_version: "0.1"
kind: agent
name: agy-cli-memory
description: "Agy CLI engine memory harness probe."

runtime:
  name: daimon
  options:
    engine: agy

execution:
  model:
    primary:
      provider: local
      name: agy-cli
      auth:
        method: none
      endpoint:
        compatibility: openai
        base_url: http://127.0.0.1:11434/v1
  sandbox:
    mode: workspace

schedule:
  kind: every
  every: 1s
  prompt: "Remember agy banana nebula marker and reply with a short agy line."

workspace:
  docs:
    system: AGENTS.md
