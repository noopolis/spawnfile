spawnfile_version: "0.1"
kind: agent
name: codex-cli-memory
description: "Codex CLI engine memory harness probe."

runtime:
  name: daimon
  options:
    engine: codex

execution:
  model:
    primary:
      provider: openai
      name: gpt-5.4-mini
      auth:
        method: codex
  sandbox:
    mode: workspace

schedule:
  kind: every
  every: 1s
  prompt: "Remember codex banana nebula marker and reply with a short codex line."

workspace:
  docs:
    system: AGENTS.md
