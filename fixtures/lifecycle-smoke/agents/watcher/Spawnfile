spawnfile_version: "0.1"
kind: agent
name: watcher
description: "Deterministic scripted watcher agent for spawnfile's own lifecycle smoke."

runtime:
  name: daimon
  options:
    engine: codex

execution:
  model:
    primary:
      provider: openai
      name: gpt-5.4-mini
      auth:
        method: codex

schedule:
  kind: cron
  cron: "0 0 * * *"

surfaces:
  moltnet:
    - network: smoke_lab
      rooms:
        smoke-room:
          wake: mentions

workspace:
  docs:
    system: AGENTS.md
