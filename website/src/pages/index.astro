---
// Landing page: standalone, bypasses the Starlight layout.
import LandingHead from '../components/LandingHead.astro';
import LandingNav from '../components/landing/LandingNav.astro';
import Hero from '../components/landing/Hero.astro';
import Format from '../components/landing/Format.astro';
import Shared from '../components/landing/Shared.astro';
import Compile from '../components/landing/Compile.astro';
import Run from '../components/landing/Run.astro';
import Harnesses from '../components/landing/Harnesses.astro';
import Boundaries from '../components/landing/Boundaries.astro';
import Train from '../components/landing/Train.astro';
import Closing from '../components/landing/Closing.astro';
import Showcase from '../components/landing/Showcase.astro';
import LandingFooter from '../components/landing/LandingFooter.astro';
import '../styles/landing.css';
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <LandingHead />
  </head>
  <body>
    <LandingNav />
    <main>
      <Hero />
      <Format />
      <Shared />
      <Compile />
      <Run />
      <Harnesses />
      <Boundaries />
      <Train />
      <Closing />
      <Showcase />
    </main>
    <LandingFooter />
    <script>
      import '../scripts/landing/index';
    </script>
  </body>
</html>
