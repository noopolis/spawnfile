---
import source from '../../../../examples/research-org/Spawnfile?raw';
import { FIELD_MEMBERS, STAGE_AGENTS, STAGE_IDLE, STAGE_OUTPUT, stageSource } from '../../scripts/landing/content';
import { harnesses } from './harnesses';
import { spawnfile } from './highlight';

const agents = STAGE_AGENTS.map((agent) => ({
  ...agent, label: harnesses.find(({ id }) => id === agent.runtime)!.name,
}));
---
<div class="stage br" id="stage">
  <div class="cols">
    <div class="col">
      <div class="step on"><i>01</i><b>Spawnfile</b><a class="note" href="/guides/teams/#compile-the-homepage-team">example org</a></div>
      {stageSource(source).map((row) => (
        <div class="row" data-g={row.g} tabindex={row.text.includes('ref:') ? 0 : undefined}><span class="n">{row.line}</span><span class="t" set:html={spawnfile(row.text)} /></div>
      ))}
    </div>
    <div class="col">
      <button type="button" class="step" data-run="compile" aria-label="Run spawnfile compile"><i>02</i><b>.spawn/</b><span class="cmd">spawnfile compile</span></button>
      {STAGE_OUTPUT.map((row) => (
        <div class="row o" data-g={row.g} data-path={row.path}><span class="t"><span class="tr">{row.tree}</span>{row.text}</span></div>
      ))}
    </div>
    <div class="col">
      <button type="button" class="step" data-run="up" aria-label="Run spawnfile up"><i>03</i><b>docker</b><span class="cmd">spawnfile up</span></button>
      <div class="box">
        <div class="room o" data-g="net" tabindex="0"><span class="h">#</span>mission-control<small>Moltnet</small></div>
        {agents.filter((agent) => !agent.field).map((agent) => (
          <div class="chip o" data-g={agent.id} data-runtime={agent.runtime} tabindex="0"><span class="dot"></span>{agent.id}<small>{agent.label}</small></div>
        ))}
        <div class="team o" data-g={FIELD_MEMBERS}>
          <span class="tn">field-team</span>
          {agents.filter((agent) => agent.field).map((agent) => (
            <div class="chip o" data-g={agent.id} data-runtime={agent.runtime} tabindex="0"><span class="dot"></span>{agent.id}<small>{agent.label}</small></div>
          ))}
        </div>
      </div>
    </div>
  </div>
  <div class="cap"><span id="stage-cap">{STAGE_IDLE}</span><a href="/guides/teams/#compile-the-homepage-team">Compile this example</a></div>
</div>
