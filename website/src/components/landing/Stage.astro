---
import { stageExamples } from './researchTeam';
import { spawnfile } from './highlight';
import StageRole from './StageRole.astro';
---
<section id="team-agent" class="team-demo br" aria-label="Team and agent examples">
  <div class="demo-panels">
    <div class="example-toolbar">
      <fieldset class="scope-switch">
        <legend>Example scope</legend>
        <input id="scope-team" type="radio" name="example-scope" value="team" autocomplete="off" checked />
        <label for="scope-team">Team</label>
        <input id="scope-agent" type="radio" name="example-scope" value="agent" autocomplete="off" />
        <label for="scope-agent">Agent</label>
      </fieldset>
      <span class="stage-file-title">Spawnfile</span>
      <fieldset class="example-views">
        <legend>Example view</legend>
        <input id="example-source-mode" name="example-view" type="radio" autocomplete="off" aria-controls="example-source" checked />
        <label for="example-source-mode">Spawnfile</label>
        <input id="example-team-mode" name="example-view" type="radio" autocomplete="off" aria-controls="example-team" aria-label="spawnfile up, preview the running example" />
        <label for="example-team-mode">Run</label>
      </fieldset>
    </div>
    <div class="demo-file" id="example-source">
      {stageExamples.map((example) => (
        <div data-scope={example.scope}>
          <pre aria-label={'Spawnfile for ' + example.name}>{example.lines.map(({ text, reference, peers }, i) => (
            <span class="source-line" data-peer={peers} tabindex={peers ? 0 : undefined}><span class="n" aria-hidden="true">{i + 1}</span><Fragment set:html={spawnfile(text)} />{reference && <span class="source-ref" set:html={spawnfile(reference)} />}</span>
          ))}</pre>
          <a class="full-source" href={example.sourceUrl}>Full Spawnfile</a>
        </div>
      ))}
    </div>
    <div class="demo-docker" id="example-team">
      <div class="demo-docker-header">
        <span class="docker-kind"><b>Docker</b><small>1 container</small></span>
        <button type="button" class="demo-command" aria-label="Replay the example startup" title="Replay the example startup"><span>$</span> spawnfile up</button>
      </div>
      {stageExamples.map((example) => {
        const roles = example.groups.flatMap((g) => g.roles);
        return <div data-scope={example.scope}>
          <details class="demo-roster" open>
            <summary class="demo-summary"><strong>{example.name}</strong><small>{roles.length} {roles.length === 1 ? 'agent' : 'agents'}</small></summary>
            <ul class="demo-roles">
              {example.groups.map((group) => group.nested
                ? <li class="field-group"><span>{group.id}</span><ul>{group.roles.map((role) => <StageRole role={role} />)}</ul></li>
                : group.roles.map((role) => <StageRole role={role} />))}
            </ul>
          </details>
          <ul class="demo-names" aria-label="Harnesses">{roles.map(({ guide }) => <li>{guide.name}</li>)}</ul>
          {example.rooms.map((room) => (
            <div class="demo-room">
              <b title="Moltnet room" aria-label={'Moltnet room ' + room.id}>#{room.id}</b>
              <small>{room.members.join(' · ')}</small>
            </div>
          ))}
          {example.facts.length > 0 && <dl class="agent-facts">{example.facts.map(([key, value]) =>
            <div><dt>{key}</dt><dd>{value}</dd></div>
          )}</dl>}
        </div>;
      })}
    </div>
  </div>
  <div class="demo-foot">
    {stageExamples.map((example) => <a data-scope={example.scope} href={example.guide}>{example.guideLabel}</a>)}
    <a href="/guides/compiling/#output-layout">Generated files</a>
  </div>
</section>
