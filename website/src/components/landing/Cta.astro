---
import { INSTALL_CMD, SETUP_PROMPT } from '../../scripts/landing/content';
---
<div class="cta">
  <button type="button" class="btn" data-copy={SETUP_PROMPT}>
    <span class="prompt-full">Copy setup prompt</span><span class="prompt-compact">Copy prompt</span>
    <small aria-hidden="true">paste into your agent</small>
  </button>
  <span class="install">
    <code><span>$</span> npm i -g spawnfile</code>
    <button type="button" data-copy={INSTALL_CMD} data-toast="Copied the install command." aria-label="Copy install command" title="Copy install command">
      <span class="copy-wide">copy</span><span class="copy-compact">Install command</span><span class="copy-mini">Copy install</span>
    </button>
  </span>
</div>
