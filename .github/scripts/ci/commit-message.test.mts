import assert from 'node:assert/strict';
import { execFileSync } from 'node:child_process';
import { chmodSync, copyFileSync, mkdirSync, mkdtempSync, readFileSync, rmSync, writeFileSync } from 'node:fs';
import { tmpdir } from 'node:os';
import { dirname, resolve } from 'node:path';
import { test } from 'node:test';
import { AUTHOR_EMAILS, DISPATCHER_MARKER, HOOKS_DIRECTORY, MAX_LENGTH, TYPES,
  authorProblem, cleanMessage, commitsIn, installHook, messageProblem, rangeProblems } from './commit-message.mts';

const allowed = 'juancfortunatti@gmail.com';
const commit = (message: string, overrides: Partial<RangeCommit> = {}): RangeCommit =>
  ({ sha: 'a'.repeat(40), parents: 1, authorEmail: allowed, message, ...overrides });
import type { RangeCommit } from './commit-message.mts';

test('one Conventional Commits line passes for every allowed type, scopes and breaking markers', () => {
  assert.deepEqual(AUTHOR_EMAILS, [allowed]);
  for (const type of TYPES) assert.equal(messageProblem(`${type}: update`), undefined);
  for (const message of ['refactor(core): move reader\n', 'fix!: drop old reader\n',
    'ci(commit-message): check every commit', 'chore(deps/pnpm): bump lockfile\n\n\n']) {
    assert.equal(messageProblem(message), undefined, message);
  }
});

test('Git comment blocks, CRLF and trailing blank lines follow the reference cleanup', () => {
  assert.deepEqual(cleanMessage('\nfeat: add x\n\n# Please enter a message\n# On branch main\n'), ['feat: add x']);
  assert.equal(messageProblem('feat: add x\r\n\r\n# comment\r\n'), undefined);
});

test('bodies, trailers and all attribution variants fail', () => {
  for (const body of ['Why it matters.', 'Signed-off-by: test <test@example.com>']) {
    assert.match(messageProblem(`feat: add x\n\n${body}\n`) ?? '', /single line/u);
  }
  for (const text of ['Co-Authored-By: test <test@example.com>', 'co-authored-by: test',
    'GENERATED WITH a tool', 'generated by a tool', '🤖']) {
    assert.match(messageProblem(`feat: ${text}`) ?? '', /attribution/u);
    assert.match(messageProblem(`feat: add x\n\n${text}\n`) ?? '', /attribution/u);
  }
});

test('nonconventional titles, invalid scopes and whitespace fail', () => {
  for (const message of ['moved reader', 'Refactor(core): move', 'feat(Core): move', 'feat(a,b): move',
    'feat(a b): move', 'feat(): move', 'feat:move', 'feat: ', 'wip: things', 'feat: trailing space ', '']) {
    assert.notEqual(messageProblem(message), undefined, JSON.stringify(message));
  }
});

test('150 characters pass and 151 fail', () => {
  assert.equal(messageProblem(`feat: ${'x'.repeat(MAX_LENGTH - 6)}`), undefined);
  assert.match(messageProblem(`feat: ${'x'.repeat(MAX_LENGTH - 5)}`) ?? '', /characters/u);
});

test('Git-generated messages preserve the reference exemptions', () => {
  for (const message of ["Merge branch 'main' into feature\n", 'Revert "feat: add x"\n\nThis reverts commit abc.\n',
    'fixup! feat: add x\n', 'squash! feat: add x\n\nmore\n', 'amend! feat: add x\n\nmore\n']) {
    assert.equal(messageProblem(message), undefined, message);
  }
});

test('the author allowlist rejects foreign, empty, GitHub and near-match emails', () => {
  assert.equal(authorProblem(allowed), undefined);
  for (const email of ['', 'bot@example.com', 'noreply@github.com', `${allowed}.evil`, allowed.toUpperCase()]) {
    assert.match(authorProblem(email) ?? '', /Author email/u, email);
  }
});

test('ranges skip merge messages while enforcing authors on merges and generated messages', () => {
  const problems = rangeProblems([commit('feat: fine'), commit('bad title', { sha: 'b'.repeat(40) }),
    commit('Any merge text\n\nwith a body', { parents: 2 }),
    commit('Any merge text', { parents: 2, authorEmail: 'bot@example.com' }),
    commit('fixup! feat: fine', { authorEmail: 'bot@example.com' })]);
  assert.equal(problems.length, 3);
  assert.match(problems[0]!, /^bbbbbbbbbb bad title\n {2}Use Conventional Commits/u);
  assert.match(problems[1]!, /Author email/u);
  assert.match(problems[2]!, /Author email/u);
});

function fixture() {
  const root = mkdtempSync(resolve(tmpdir(), 'commit-message-'));
  const env = { ...process.env, GIT_CONFIG_GLOBAL: '/dev/null', GIT_CONFIG_NOSYSTEM: '1',
    GIT_AUTHOR_NAME: 'test', GIT_AUTHOR_EMAIL: allowed, GIT_COMMITTER_NAME: 'test', GIT_COMMITTER_EMAIL: allowed };
  const git = (...args: string[]) => execFileSync('git', args, { cwd: root, env, encoding: 'utf8', stdio: ['pipe', 'pipe', 'pipe'] }).trim();
  git('init', '-q');
  git('config', 'user.name', 'test');
  git('config', 'user.email', allowed);
  for (const path of ['.github/hooks/commit-msg', '.github/scripts/ci/commit-message.mts']) {
    mkdirSync(dirname(resolve(root, path)), { recursive: true });
    copyFileSync(resolve(import.meta.dirname, '../../..', path), resolve(root, path));
  }
  chmodSync(resolve(root, '.github/hooks/commit-msg'), 0o755);
  const tree = git('mktree');
  const makeCommit = (message: string, parents: string[] = [], author = allowed, committer = allowed) =>
    execFileSync('git', ['commit-tree', tree, ...parents.flatMap(parent => ['-p', parent]), '-m', message],
      { cwd: root, env: { ...env, GIT_AUTHOR_EMAIL: author, GIT_COMMITTER_EMAIL: committer }, encoding: 'utf8' }).trim();
  const start = makeCommit('chore: start');
  git('update-ref', 'HEAD', start);
  const checker = resolve(root, '.github/scripts/ci/commit-message.mts');
  const run = (...args: string[]) => execFileSync(process.execPath, [checker, ...args], { cwd: root, env, encoding: 'utf8', stdio: ['pipe', 'pipe', 'pipe'] });
  const hook = (message: string, author = allowed) => {
    const file = resolve(root, 'message');
    writeFileSync(file, message);
    return execFileSync('git', ['hook', 'run', 'commit-msg', '--', file],
      { cwd: root, env: { ...env, GIT_AUTHOR_EMAIL: author }, encoding: 'utf8', stdio: ['pipe', 'pipe', 'pipe'] });
  };
  return { root, env, git, start, makeCommit, checker, run, hook };
}

test('real Git ranges use the original author, permit GitHub committers and preserve message separators', async () => {
  const f = fixture();
  try {
    const good = f.makeCommit('feat: good', [f.start], allowed, 'noreply@github.com');
    const bad = f.makeCommit('feat: bad\n\n\u001e\u001fhidden', [good], 'bot@example.com');
    const merge = f.makeCommit('arbitrary merge body\n\nmore', [good, bad]);
    const commits = await commitsIn(`${f.start}..${merge}`, f.root);
    assert.equal(commits.length, 3);
    assert.equal(commits.find(c => c.sha === good)?.authorEmail, allowed);
    assert.match(commits.find(c => c.sha === bad)?.message ?? '', /\u001e\u001fhidden/u);
    const problems = rangeProblems(commits);
    assert.equal(problems.length, 1);
    assert.match(problems[0]!, /bot@example.com/u);
    f.run('--range', `${f.start}..${good}`);
    assert.throws(() => f.run('--range', `${f.start}..${merge}`), /Author email/u);
    const foreignMerge = f.makeCommit('Merge branches', [good, bad], 'bot@example.com', 'noreply@github.com');
    assert.equal(rangeProblems(await commitsIn(`${merge}..${foreignMerge}`, f.root)).length, 1);
  } finally { rmSync(f.root, { recursive: true, force: true }); }
});

test('invalid ranges and CLI arguments fail closed', () => {
  const f = fixture();
  try {
    assert.throws(() => f.run('--range', 'missing-ref..HEAD'), /unknown revision|ambiguous argument|bad revision/u);
    assert.throws(() => f.run('--unknown'), /Usage/u);
    assert.throws(() => f.run('missing-file'), /ENOENT/u);
  } finally { rmSync(f.root, { recursive: true, force: true }); }
});

test('the installed hook rejects bad messages and author overrides, and reinstalls idempotently', async () => {
  const f = fixture();
  try {
    assert.match(await installHook(f.root), /Installed/u);
    assert.equal(f.git('config', '--get', 'core.hooksPath'), resolve(f.root, '.git', HOOKS_DIRECTORY));
    assert.throws(() => f.hook('Bad message'), /Conventional Commits/u);
    assert.throws(() => f.hook('chore: fine\n\nbody'), /single line/u);
    assert.throws(() => f.hook('chore: generated by a tool'), /attribution/u);
    assert.throws(() => f.hook('chore: fine', 'bot@example.com'), /Author email/u);
    assert.throws(() => f.hook('Merge branch main', 'bot@example.com'), /Author email/u);
    f.hook('chore: fine');
    assert.match(await installHook(f.root), /Installed/u);
    assert.throws(() => f.hook('Bad message'), /Conventional Commits/u);
  } finally { rmSync(f.root, { recursive: true, force: true }); }
});

test('the installer preserves user hooks, custom paths, empty settings and foreign dispatchers', async () => {
  const f = fixture();
  try {
    const own = resolve(f.root, '.git/hooks/pre-commit');
    writeFileSync(own, '#!/bin/sh\necho mine\n', { mode: 0o755 });
    assert.match(await installHook(f.root), /hooks of your own/u);
    assert.throws(() => f.git('config', '--get', 'core.hooksPath'));
    rmSync(own);
    for (const path of ['custom-hooks', '']) {
      f.git('config', 'core.hooksPath', path);
      assert.match(await installHook(f.root), /left unchanged/u);
      assert.equal(f.git('config', '--get', 'core.hooksPath'), path);
    }
    f.git('config', '--unset', 'core.hooksPath');
    const target = resolve(f.root, '.git', HOOKS_DIRECTORY, 'commit-msg');
    mkdirSync(dirname(target), { recursive: true });
    writeFileSync(target, '#!/bin/sh\necho mine\n');
    assert.match(await installHook(f.root), /not this installer's dispatcher/u);
    assert.equal(readFileSync(target, 'utf8'), '#!/bin/sh\necho mine\n');
  } finally { rmSync(f.root, { recursive: true, force: true }); }
});

test('direct opt-in hooks and shared dispatchers fail when tracked inputs disappear', async () => {
  const f = fixture();
  try {
    f.git('config', 'core.hooksPath', '.github/hooks');
    f.hook('chore: fine');
    rmSync(f.checker);
    assert.throws(() => f.hook('chore: fine'), /commit-message\.mts is missing/u);
    copyFileSync(resolve(import.meta.dirname, 'commit-message.mts'), f.checker);
    f.git('config', '--unset', 'core.hooksPath');
    assert.match(await installHook(f.root), /Installed/u);
    assert.match(readFileSync(resolve(f.root, '.git', HOOKS_DIRECTORY, 'commit-msg'), 'utf8'), new RegExp(DISPATCHER_MARKER, 'u'));
    rmSync(resolve(f.root, '.github/hooks/commit-msg'));
    assert.throws(() => f.hook('chore: fine'), /commit-msg is missing/u);
  } finally { rmSync(f.root, { recursive: true, force: true }); }
});

test('the dispatcher follows the calling linked worktree and does not capture its install location', async () => {
  const f = fixture();
  try {
    await installHook(f.root);
    const linked = resolve(f.root, 'linked');
    f.git('worktree', 'add', '-q', '--detach', linked, f.start);
    mkdirSync(resolve(linked, '.github/hooks'), { recursive: true });
    writeFileSync(resolve(linked, '.github/hooks/commit-msg'), '#!/bin/sh\necho linked-worktree >&2\nexit 7\n');
    const message = resolve(linked, 'message');
    writeFileSync(message, 'chore: fine');
    assert.throws(() => execFileSync('git', ['hook', 'run', 'commit-msg', '--', message],
      { cwd: linked, env: f.env, encoding: 'utf8', stdio: ['pipe', 'pipe', 'pipe'] }), /linked-worktree/u);
    f.hook('chore: fine');
  } finally { rmSync(f.root, { recursive: true, force: true }); }
});
