{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": [
      "ES2023",
      "DOM"
    ],
    "noUncheckedIndexedAccess": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "src/training/**/*.ts",
    "tooling/training/**/*.ts",
    "src/runtime/daimon/training/**/*.ts",
    "src/runtime/codex-exec/**/*.ts"
  ],
  "exclude": [
    "src/training/copyAssets.ts"
  ]
}
