spawnfile_version: "0.1"
kind: agent
name: sam
description: "Sam is Eleanor's partner and a friend outside the office."

runtime:
  name: pi
  options:
    engine: grok

execution:
  model:
    primary:
      provider: local
      name: grok-cli
      auth:
        method: none
      endpoint:
        compatibility: openai
        base_url: http://127.0.0.1:11434/v1
  sandbox:
    mode: workspace

surfaces:
  moltnet:
    - network: memetics_lab
      rooms:
        eleanor-home:
          wake: mentions

workspace:
  docs:
    system: AGENTS.md
