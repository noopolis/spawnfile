spawnfile_version: "0.1"
kind: agent
name: grok-cli-memory
description: "Grok CLI engine memory harness probe."

runtime:
  name: daimon
  options:
    engine: grok

execution:
  model:
    primary:
      provider: local
      name: grok-cli
      auth:
        method: none
      endpoint:
        compatibility: openai
        base_url: http://127.0.0.1:11434/v1
  sandbox:
    mode: workspace

schedule:
  kind: every
  every: 1s
  prompt: "Remember grok banana nebula marker and reply with a short grok line."

workspace:
  docs:
    system: AGENTS.md
