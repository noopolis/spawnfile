spawnfile_version: "0.1"
kind: team
name: daimon-review-team
description: "Nested review team for the legacy generated-Pi fixture"

members:
  - id: reviewer
    ref: ./agents/reviewer

memory:
  - id: shared-recall
    access:
      members: [reviewer]
    store:
      kind: json
      path: /var/lib/spawnfile/memory/daimon-org/shared-recall.jsonl
      persistence:
        mode: durable
    index:
      lexical:
        enabled: true
        engine: sqlite_fts
      vector:
        enabled: true
        provider: ollama
        model: qwen3-embedding:0.6b
        dimensions: 1024

mode: hierarchical
lead: reviewer

networks:
  - id: daimon_lab
    name: Daimon Lab
    provider: moltnet
    server:
      mode: managed
      listen:
        bind: 0.0.0.0
        port: 19877
      store:
        kind: sqlite
        path: /var/lib/spawnfile/moltnet/networks/daimon_lab/moltnet.sqlite
      auth:
        mode: open
        public_read: true
      human_ingress: true
      direct_messages: false
    rooms:
      - id: lab-floor
        members: [reviewer]
        visibility: public
        write_policy: registered_agents
